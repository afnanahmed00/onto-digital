{
  "name": "onto-digital-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ONTO DIGITAL backend API (Express + TypeScript), deployed independently of the frontend.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "seed-services": "tsx src/scripts/seedServices.ts",
    "seed-projects": "tsx src/scripts/seedProjects.ts"
  },
  "engines": {
  "node": "24.x"
},
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
