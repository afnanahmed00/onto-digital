# Copy this file to .env and fill in real values locally.
# Never commit .env — it's already in .gitignore.

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Include both the local dev URL and the production Vercel URL.
CORS_ORIGIN=http://localhost:3000

# ── Database — MongoDB Atlas ─────────────────────────────────────────────
# Optional in development (the server runs without it, just without any
# database-backed routes). Required in production — the server refuses to
# start if NODE_ENV=production and this is unset.
MONGODB_URI=

# ── Authentication — admin login ────────────────────────────────────────
# Required for the server to start. Signs/verifies admin session tokens —
# generate a random value (e.g. `openssl rand -hex 32`), at least 32
# characters. Never reuse this across environments or commit a real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Admin account setup — one-time use only ─────────────────────────────
# Not read by the server itself — only by `npm run create-admin`, which
# creates the single ONTO DIGITAL admin account and refuses to run again
# once one exists. Set these here temporarily, run the script, then clear
# them (leaving stale credentials in .env serves no purpose once the
# account exists, and this file must never be committed).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Image storage — Cloudinary ──────────────────────────────────────────
# Required for the server to start. Copy these from your Cloudinary
# dashboard (Free tier). Used only by routes/v1/uploads.routes.ts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
